#!/bin/sh

# sys-update-rhel: RHEL system update - DNF, firmware (fwupdmgr), Flatpak
#
# Usage:
#   sys-update-rhel       show what is pending in each step, then ask [y/N]
#                         before applying it (Enter or anything else = no)
#   sys-update-rhel -y    unattended: no previews, no questions, apply all
#   sys-update-rhel -h    this help
#
# Never reboots. Output and every answer are appended to the log below.
# No answer at all (EOF on stdin, e.g. run from cron) counts as "no", so a
# run without -y that nobody is there to answer changes nothing.

# Define log path
LOG_FILE="$HOME/rhel_update_history.log"

usage() {
    cat <<'USAGE'
usage: sys-update-rhel [-y|--yes] [-h|--help]
  (no option)  preview each step and ask [y/N] before applying it
  -y, --yes    unattended: skip previews and questions, apply everything
USAGE
}

ASSUME_YES=no
[ $# -le 1 ] || { usage >&2; exit 2; }
case "${1:-}" in
    "")        ;;
    -y|--yes)  ASSUME_YES=yes ;;
    -h|--help) usage; exit 0 ;;
    *)         usage >&2; exit 2 ;;
esac

# Clear line helper
print_sep() {
    echo "================================================================================" | tee -a "$LOG_FILE"
}

# Show what a step would change, using a read-only command (interactive runs only)
preview() {
    [ "$ASSUME_YES" = yes ] && return 0
    "$@" 2>&1 | tee -a "$LOG_FILE"
}

# Ask before a step. -y answers for you; EOF or anything but y/yes is "no".
confirm() {
    if [ "$ASSUME_YES" = yes ]; then
        echo "$1 -> yes (-y)" >> "$LOG_FILE"
        return 0
    fi
    printf '%s [y/N] ' "$1"
    read -r answer || answer=n
    echo "$1 -> ${answer:-n}" >> "$LOG_FILE"
    case "$answer" in
        [yY]|[yY][eE][sS]) return 0 ;;
    esac
    return 1
}

# Start logging session
print_sep
echo "STARTING COMPLETE RHEL SYSTEM UPDATE: $(date)" | tee -a "$LOG_FILE"
print_sep

# 1. Native DNF OS Upgrade
printf "\n[1/3] Running Native DNF OS Upgrade...\n" | tee -a "$LOG_FILE"
print_sep
preview sudo dnf check-update       # exit 100 just means "updates available"
if confirm "Apply the DNF upgrade?"; then
    sudo dnf upgrade -y 2>&1 | tee -a "$LOG_FILE"
else
    echo "DNF upgrade skipped." | tee -a "$LOG_FILE"
fi

# 2. Hardware Firmware Update
printf "\n[2/3] Running Hardware Firmware Updates (fwupdmgr)...\n" | tee -a "$LOG_FILE"
print_sep
sudo fwupdmgr refresh 2>&1 | tee -a "$LOG_FILE"
preview fwupdmgr get-updates        # exit 2 just means "no updates"
if confirm "Apply the firmware updates?"; then
    # -y answers yes to every question, which can include fwupdmgr's "An update
    # requires a reboot to complete. Restart now?" prompt. --no-reboot-check skips
    # that prompt so the script cannot reboot itself mid-run (and skip step 3 and
    # the closing log lines). Reboot yourself afterwards.
    sudo fwupdmgr update -y --no-reboot-check 2>&1 | tee -a "$LOG_FILE"
else
    echo "Firmware update skipped." | tee -a "$LOG_FILE"
fi

# 3. Flatpak Desktop Apps Update (Executed safely as standard user)
printf "\n[3/3] Running Flatpak Desktop App Updates...\n" | tee -a "$LOG_FILE"
print_sep
preview flatpak remote-ls --updates
if confirm "Apply the Flatpak updates?"; then
    flatpak update -y 2>&1 | tee -a "$LOG_FILE"
else
    echo "Flatpak update skipped." | tee -a "$LOG_FILE"
fi

# Finish logging session
print_sep
echo "SYSTEM UPDATE COMPLETE: $(date)" | tee -a "$LOG_FILE"
echo "NOTE: this script never reboots - reboot to finish any kernel or firmware updates." | tee -a "$LOG_FILE"
print_sep
echo "Log file saved successfully to: $LOG_FILE"
